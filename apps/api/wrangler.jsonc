{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "product-request-hub-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "WEB_BASE_URL": "http://localhost:3000",
    // Cloudflare Access (Zero Trust) that fronts the management app:
    //   CF_ACCESS_TEAM_DOMAIN  e.g. "your-team.cloudflareaccess.com"
    //   CF_ACCESS_AUD          the Access application's "Application Audience (AUD) Tag"
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "product-request-hub",
      // `wrangler d1 create product-request-hub` prints the id (scripts/setup.sh fills it in).
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Plain SQL generated by drizzle-kit; applied with `pnpm db:migrate`.
      "migrations_dir": "../../packages/database/migrations"
    }
  ]
  // Secrets (wrangler secret put ...):
  //   DISCORD_PUBLIC_KEY, DISCORD_APPLICATION_ID, DISCORD_BOT_TOKEN
}
